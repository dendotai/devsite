{
  "name": "@den-ai/devsite",
  "version": "0.0.0",
  "type": "module",
  "description": "Port-less dev URLs: one stable https://<name>.internal and https://<name>.localhost per project, with self-registered Caddy routes and phone access over Tailscale.",
  "license": "MIT",
  "author": "Den Kasyanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dendotai/devsite.git"
  },
  "homepage": "https://github.com/dendotai/devsite#readme",
  "bugs": "https://github.com/dendotai/devsite/issues",
  "keywords": [
    "bun",
    "vite",
    "vite-plugin",
    "caddy",
    "https",
    "dev-server",
    "local-development",
    "tailscale"
  ],
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main"
    ],
    "preset": "conventionalcommits",
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "failComment": false
        }
      ]
    ]
  },
  "bin": {
    "devsite": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./vite": {
      "types": "./src/vite.types.d.mts",
      "default": "./src/vite.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target=node --external koffi --banner '#!/usr/bin/env node'",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "prepare": "[ -n \"$CI\" ] || ! git rev-parse --git-dir >/dev/null 2>&1 || git config core.hooksPath .githooks",
    "check:commit-msg": "commitlint --edit",
    "check:pre-commit": "bun run lint",
    "check:pre-push": "bun run typecheck && bun run test",
    "scenarios": "rm -f scenarios.md && DEVSITE_SCENARIOS_FILE=$PWD/scenarios.md bun test tests/init.test.ts tests/ca.test.ts tests/doctor.test.ts tests/dnsmasq.test.ts tests/install.test.ts tests/keep-settings.test.ts"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.2.21",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "typescript": "^5.9.2",
    "vite": "^8.0.10"
  },
  "dependencies": {
    "koffi": "^3.3.8"
  },
  "packageManager": "bun@1.4.3"
}
