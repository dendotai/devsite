{
  "name": "@den-ai/devsite",
  "version": "0.0.0",
  "type": "module",
  "description": "Port-less dev URLs: one stable https://<name>.internal per project, with self-registered Caddy routes and phone access over Tailscale.",
  "license": "MIT",
  "author": "Den Kasyanov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dendotai/devsite.git"
  },
  "homepage": "https://github.com/dendotai/devsite#readme",
  "bugs": "https://github.com/dendotai/devsite/issues",
  "keywords": [
    "bun",
    "vite",
    "vite-plugin",
    "caddy",
    "https",
    "dev-server",
    "local-development",
    "tailscale"
  ],
  "publishConfig": {
    "access": "public"
  },
  "release": {
    "branches": [
      "main"
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/release-notes-generator",
      "@semantic-release/npm",
      [
        "@semantic-release/github",
        {
          "successComment": false,
          "failComment": false
        }
      ]
    ]
  },
  "bin": {
    "devsite": "dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    "./vite": {
      "types": "./src/vite.types.d.mts",
      "default": "./src/vite.mjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --outdir dist --target=node --banner '#!/usr/bin/env node'",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test"
  },
  "peerDependencies": {
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/bun": "^1.2.21",
    "typescript": "^5.9.2",
    "vite": "^8.0.10"
  }
}
