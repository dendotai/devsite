#!/bin/sh
# A stand-in for the tailscale CLI: it prints the answers a test wrote into $DEVSITE_FAKE_TAILSCALE, and fails as a tailnet with no such answer does.
d="$DEVSITE_FAKE_TAILSCALE"
case "$1 $2" in
"status --json")
  [ -f "$d/status.json" ] && exec cat "$d/status.json"
  echo "Tailscale is stopped." >&2
  ;;
"whois --json")
  [ -f "$d/whois-$3.json" ] && exec cat "$d/whois-$3.json"
  echo "peer not found" >&2
  ;;
esac
exit 1
